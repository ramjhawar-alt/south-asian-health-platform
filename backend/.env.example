# ── LLM ──────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings ────────────────────────────────────────────
# Voyage AI — voyage-3.5 model (state-of-the-art general embeddings)
# Free tier: 50M tokens/month. Get key at https://dash.voyageai.com
VOYAGE_API_KEY=your_voyage_api_key_here

# ── PubMed / Entrez ───────────────────────────────────────
# Required for paper ingestion — any valid email works
ENTREZ_EMAIL=your_email@example.com

# ── Database paths ────────────────────────────────────────
CHROMA_DB_PATH=../data/chroma_db
PAPERS_DIR=../data/papers
KNOWLEDGE_BASE_PATH=../data/knowledge_base
FIGURES_DIR=../data/figures

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://south-asian-health.vercel.app
