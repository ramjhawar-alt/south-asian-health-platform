{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/ingest/:path*",
      "destination": "https://south-asian-health-backend.onrender.com/api/ingest/:path*"
    },
    {
      "source": "/api/kb/:path*",
      "destination": "https://south-asian-health-backend.onrender.com/api/kb/:path*"
    },
    {
      "source": "/api/figures/:path*",
      "destination": "https://south-asian-health-backend.onrender.com/api/figures/:path*"
    }
  ]
}
